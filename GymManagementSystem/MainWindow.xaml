<Window x:Class="GymManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Titan Fitness - Gym Management System" Height="780" Width="1240"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="18,22,18,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource PrimaryBrush}" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                            <TextBlock Text="🏋" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TITAN GYM" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Management System" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Height="1" Fill="#1E293B" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- Navigation List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,0">
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource SidebarNavButtonStyle}" Content="🏠  Dashboard" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavMembers" Style="{StaticResource SidebarNavButtonStyle}" Content="👥  Members" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavMemberships" Style="{StaticResource SidebarNavButtonStyle}" Content="📋  Memberships &amp; Plans" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTrainers" Style="{StaticResource SidebarNavButtonStyle}" Content="🏃  Trainers" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavAttendance" Style="{StaticResource SidebarNavButtonStyle}" Content="⏱  Attendance" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavPayments" Style="{StaticResource SidebarNavButtonStyle}" Content="💳  Payments" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavReports" Style="{StaticResource SidebarNavButtonStyle}" Content="📊  Reports" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavStaff" Style="{StaticResource SidebarNavButtonStyle}" Content="🛡  Staff Accounts" Checked="Nav_Checked"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom User Profile Card & Logout -->
                <Border Grid.Row="2" Background="#1E293B" Padding="14,12" Margin="10,0,10,12" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStaffName" Text="Admin User" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtStaffRole" Text="Role: Admin" FontSize="10" Foreground="#5EEAD4" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="Logout" Style="{StaticResource DangerButtonStyle}" Padding="8,4" FontSize="11" Click="BtnLogout_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock x:Name="TxtActivePageTitle" Text="Dashboard" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCurrentDateTime" Text="Sunday, October 11, 2026" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="🔄" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" ToolTip="Refresh View" Click="BtnRefreshHeader_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- View Container -->
            <ContentControl x:Name="MainContentHost" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
