<Window x:Class="GymManagementSystem.Views.Dialogs.TrainerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trainer Details" Height="400" Width="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBgBrush}">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="TxtDialogTitle" Text="Add Trainer" Style="{StaticResource HeaderTitleStyle}" FontSize="20"/>
                <TextBlock Text="Add trainer profile and availability schedule" Style="{StaticResource HeaderSubtitleStyle}" Margin="0,0,0,0"/>
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="Full Name *" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="TxtFullName" Style="{StaticResource ModernTextBoxStyle}"/>

                <TextBlock Text="Specialization *" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="TxtSpecialization" Style="{StaticResource ModernTextBoxStyle}"/>

                <TextBlock Text="Contact Number *" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="TxtContact" Style="{StaticResource ModernTextBoxStyle}"/>

                <TextBlock Text="Availability *" Style="{StaticResource FormLabelStyle}"/>
                <ComboBox x:Name="CmbAvailability" Style="{StaticResource ModernComboBoxStyle}">
                    <ComboBoxItem Content="Morning (6 AM - 12 PM)" IsSelected="True"/>
                    <ComboBoxItem Content="Evening (3 PM - 9 PM)"/>
                    <ComboBoxItem Content="Full Day"/>
                    <ComboBoxItem Content="Weekend Only"/>
                </ComboBox>

                <TextBlock x:Name="TxtError" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90" Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnSave" Content="Save Trainer" Style="{StaticResource PrimaryButtonStyle}" Width="120" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
