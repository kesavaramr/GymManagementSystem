<Window x:Class="GymManagementSystem.Views.Dialogs.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payment Receipt" Height="620" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBgBrush}">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Payment Receipt" Style="{StaticResource HeaderTitleStyle}" FontSize="20"/>
                <TextBlock Text="Official receipt for gym membership payment" Style="{StaticResource HeaderSubtitleStyle}" Margin="0,0,0,0"/>
            </StackPanel>

            <!-- Receipt Container -->
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtReceiptContent" FontFamily="Consolas, Courier New, monospace" FontSize="13" Foreground="#0F172A" LineHeight="20" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <!-- Actions -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Button Content="Save as File" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Width="110" Click="BtnSaveFile_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Print Receipt" Style="{StaticResource PrimaryButtonStyle}" Width="110" Click="BtnPrint_Click" Margin="0,0,8,0"/>
                    <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}" Width="80" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
