<Window x:Class="GymManagementSystem.Views.Dialogs.PlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Membership Plan" Height="400" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBgBrush}">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="TxtDialogTitle" Text="Add Membership Plan" Style="{StaticResource HeaderTitleStyle}" FontSize="20"/>
                <TextBlock Text="Configure plan duration, name, and fee" Style="{StaticResource HeaderSubtitleStyle}" Margin="0,0,0,0"/>
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="Plan Name *" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="TxtPlanName" Style="{StaticResource ModernTextBoxStyle}"/>

                <TextBlock Text="Duration (Months) *" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="TxtDuration" Style="{StaticResource ModernTextBoxStyle}" Text="1"/>

                <TextBlock Text="Price *" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="TxtPrice" Style="{StaticResource ModernTextBoxStyle}" Text="45.00"/>

                <TextBlock Text="Description" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="TxtDescription" Style="{StaticResource ModernTextBoxStyle}"/>

                <TextBlock x:Name="TxtError" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90" Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnSave" Content="Save Plan" Style="{StaticResource PrimaryButtonStyle}" Width="110" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
