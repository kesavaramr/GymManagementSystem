<Window x:Class="GymManagementSystem.Views.Dialogs.AssignMembershipDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign / Renew Membership" Height="480" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBgBrush}">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="TxtTitle" Text="Assign Membership Plan" Style="{StaticResource HeaderTitleStyle}" FontSize="20"/>
                <TextBlock Text="Select a gym member and a membership plan" Style="{StaticResource HeaderSubtitleStyle}" Margin="0,0,0,0"/>
            </StackPanel>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Member *" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox x:Name="CmbMember" Style="{StaticResource ModernComboBoxStyle}" DisplayMemberPath="FullName" SelectedValuePath="MemberId" SelectionChanged="CmbMember_SelectionChanged"/>

                    <TextBlock Text="Membership Plan *" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox x:Name="CmbPlan" Style="{StaticResource ModernComboBoxStyle}" DisplayMemberPath="PlanName" SelectedValuePath="PlanId" SelectionChanged="CmbPlan_SelectionChanged"/>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Plan Fee" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="TxtPlanPrice" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Background="#F8FAFC"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Duration" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="TxtPlanDuration" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Background="#F8FAFC"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Start Date *" Style="{StaticResource FormLabelStyle}"/>
                            <DatePicker x:Name="DpStartDate" Style="{StaticResource ModernDatePickerStyle}" SelectedDateChanged="DpStartDate_SelectedDateChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Calculated Expiry" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="TxtExpiryDate" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Background="#F8FAFC"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Notes / Remarks" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtNotes" Style="{StaticResource ModernTextBoxStyle}"/>

                    <CheckBox x:Name="ChkRecordPayment" Content="Record payment as Paid immediately" Margin="0,14,0,0" IsChecked="True" FontSize="13"/>

                    <TextBlock x:Name="TxtError" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90" Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnSubmit" Content="Assign Plan" Style="{StaticResource PrimaryButtonStyle}" Width="120" Click="BtnSubmit_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
