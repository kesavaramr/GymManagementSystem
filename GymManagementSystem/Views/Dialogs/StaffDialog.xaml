<Window x:Class="GymManagementSystem.Views.Dialogs.StaffDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Staff Account" Height="480" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBgBrush}">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="TxtTitle" Text="Create Staff Account" Style="{StaticResource HeaderTitleStyle}" FontSize="20"/>
                <TextBlock Text="Grant role-based access for gym employees" Style="{StaticResource HeaderSubtitleStyle}" Margin="0,0,0,0"/>
            </StackPanel>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Full Name *" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtFullName" Style="{StaticResource ModernTextBoxStyle}"/>

                    <TextBlock Text="Username *" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtUsername" Style="{StaticResource ModernTextBoxStyle}"/>

                    <TextBlock Text="Role *" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox x:Name="CmbRole" Style="{StaticResource ModernComboBoxStyle}">
                        <ComboBoxItem Content="Staff" IsSelected="True"/>
                        <ComboBoxItem Content="Admin"/>
                    </ComboBox>

                    <TextBlock Text="Contact Number" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtContact" Style="{StaticResource ModernTextBoxStyle}"/>

                    <TextBlock x:Name="LblPassword" Text="Password *" Style="{StaticResource FormLabelStyle}"/>
                    <PasswordBox x:Name="TxtPassword" Style="{StaticResource ModernPasswordBoxStyle}"/>

                    <TextBlock x:Name="LblConfirmPassword" Text="Confirm Password *" Style="{StaticResource FormLabelStyle}"/>
                    <PasswordBox x:Name="TxtConfirmPassword" Style="{StaticResource ModernPasswordBoxStyle}"/>

                    <TextBlock x:Name="TxtError" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90" Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnSave" Content="Save Account" Style="{StaticResource PrimaryButtonStyle}" Width="120" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
