<Window x:Class="GymManagementSystem.Views.Dialogs.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Payment" Height="520" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBgBrush}">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Record Membership Payment" Style="{StaticResource HeaderTitleStyle}" FontSize="20"/>
                <TextBlock Text="Auto-calculate fees by plan and issue payment record" Style="{StaticResource HeaderSubtitleStyle}" Margin="0,0,0,0"/>
            </StackPanel>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Member *" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox x:Name="CmbMember" Style="{StaticResource ModernComboBoxStyle}" DisplayMemberPath="FullName" SelectedValuePath="MemberId" SelectionChanged="CmbMember_SelectionChanged"/>

                    <TextBlock Text="Membership / Plan" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox x:Name="CmbPlan" Style="{StaticResource ModernComboBoxStyle}" DisplayMemberPath="PlanName" SelectedValuePath="PlanId" SelectionChanged="CmbPlan_SelectionChanged"/>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Amount ($) *" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="TxtAmount" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Payment Status *" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox x:Name="CmbStatus" Style="{StaticResource ModernComboBoxStyle}">
                                <ComboBoxItem Content="Paid" IsSelected="True"/>
                                <ComboBoxItem Content="Pending"/>
                                <ComboBoxItem Content="Overdue"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Payment Method *" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox x:Name="CmbMethod" Style="{StaticResource ModernComboBoxStyle}">
                                <ComboBoxItem Content="Cash" IsSelected="True"/>
                                <ComboBoxItem Content="Credit Card"/>
                                <ComboBoxItem Content="Debit Card"/>
                                <ComboBoxItem Content="Bank Transfer"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Payment Date" Style="{StaticResource FormLabelStyle}"/>
                            <DatePicker x:Name="DpPaymentDate" Style="{StaticResource ModernDatePickerStyle}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Notes / Description" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtNotes" Style="{StaticResource ModernTextBoxStyle}"/>

                    <CheckBox x:Name="ChkOpenReceipt" Content="Generate &amp; view receipt upon saving" Margin="0,14,0,0" IsChecked="True" FontSize="13"/>

                    <TextBlock x:Name="TxtError" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90" Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnSave" Content="Save Payment" Style="{StaticResource PrimaryButtonStyle}" Width="120" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
