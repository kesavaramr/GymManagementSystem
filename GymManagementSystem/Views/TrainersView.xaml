<UserControl x:Class="GymManagementSystem.Views.TrainersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBgBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Trainer Management" Style="{StaticResource HeaderTitleStyle}"/>
                <TextBlock Text="Maintain gym fitness trainers, specializations, contact details, and schedules" Style="{StaticResource HeaderSubtitleStyle}"/>
            </StackPanel>
            <Button Content="+ Add Trainer" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnAddTrainer_Click"/>
        </Grid>

        <!-- Search Bar Card -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Search Trainers" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtSearch" Style="{StaticResource ModernTextBoxStyle}" TextChanged="TxtSearch_TextChanged"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Clear" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" Click="BtnClear_Click"/>
            </Grid>
        </Border>

        <!-- Trainers DataGrid Card -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid x:Name="DgTrainers" Style="{StaticResource ModernDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Trainer ID" Binding="{Binding DisplayId}" Width="110"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="200"/>
                    <DataGridTextColumn Header="Specialization" Binding="{Binding Specialization}" Width="240"/>
                    <DataGridTextColumn Header="Contact Number" Binding="{Binding Contact}" Width="150"/>
                    <DataGridTextColumn Header="Availability / Schedule" Binding="{Binding Availability}" Width="220"/>
                    <DataGridTemplateColumn Header="Actions" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" Style="{StaticResource ActionGridButtonStyle}" Click="BtnEditTrainer_Click"/>
                                    <Button Content="Delete" Style="{StaticResource DangerButtonStyle}" Click="BtnDeleteTrainer_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock x:Name="TxtFooterCount" Grid.Row="3" Text="Total 0 trainers" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="4,8,0,0"/>
    </Grid>
</UserControl>
