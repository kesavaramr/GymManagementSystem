<UserControl x:Class="GymManagementSystem.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Reports &amp; Analytics" Style="{StaticResource HeaderTitleStyle}"/>
                    <TextBlock Text="Summary reports on membership statuses, attendance activity, and payment collections" Style="{StaticResource HeaderSubtitleStyle}"/>
                </StackPanel>
                <Button Content="💾 Export Report to File" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnExportReport_Click"/>
            </Grid>

            <!-- Date Range Filter Card -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="From Date" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,2"/>
                        <DatePicker x:Name="DpStartDate" Style="{StaticResource ModernDatePickerStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="To Date" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,2"/>
                        <DatePicker x:Name="DpEndDate" Style="{StaticResource ModernDatePickerStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="Generate Report" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Height="36" Click="BtnGenerate_Click"/>
                </Grid>
            </Border>

            <!-- 2-Column Summary Cards -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Membership Distribution Card -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Membership Status Summary" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <DataGrid x:Name="DgMembershipReport" Style="{StaticResource ModernDataGridStyle}" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="200"/>
                                <DataGridTextColumn Header="Member Count" Binding="{Binding Count}" Width="120"/>
                                <DataGridTextColumn Header="Share (%)" Binding="{Binding Percentage, StringFormat='{}{0}%'}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Financial Revenue Summary Card -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Financial Collection Summary" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="TOTAL PAID" FontSize="11" FontWeight="SemiBold" Foreground="#047857"/>
                                    <TextBlock x:Name="TxtTotalPaid" Text="0.00" FontSize="18" FontWeight="Bold" Foreground="#065F46"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="PENDING" FontSize="11" FontWeight="SemiBold" Foreground="#B45309"/>
                                    <TextBlock x:Name="TxtTotalPending" Text="0.00" FontSize="18" FontWeight="Bold" Foreground="#92400E" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="OVERDUE" FontSize="11" FontWeight="SemiBold" Foreground="#B91C1C"/>
                                    <TextBlock x:Name="TxtTotalOverdue" Text="0.00" FontSize="18" FontWeight="Bold" Foreground="#991B1B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="Payment Methods Breakdown:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,6"/>
                        <TextBlock x:Name="TxtPaymentBreakdown" Text="No payments recorded in this period." Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" LineHeight="20"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Attendance Summary Card -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Period Attendance Overview" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtAttendanceStats" Text="Calculating attendance..." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,12"/>
                    <DataGrid x:Name="DgRecentAttendance" Style="{StaticResource ModernDataGridStyle}" MaxHeight="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Member ID" Binding="{Binding DisplayMemberId}" Width="120"/>
                            <DataGridTextColumn Header="Member Name" Binding="{Binding MemberName}" Width="220"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding FormattedDate}" Width="130"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding CheckInTime}" Width="130"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
