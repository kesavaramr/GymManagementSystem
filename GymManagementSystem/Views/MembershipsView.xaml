<UserControl x:Class="GymManagementSystem.Views.MembershipsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBgBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Membership Management" Style="{StaticResource HeaderTitleStyle}"/>
                <TextBlock Text="Manage gym plans, subscription packages, member assignments, and renewals" Style="{StaticResource HeaderSubtitleStyle}"/>
            </StackPanel>
        </Grid>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: Assigned Memberships -->
            <TabItem Header="Member Subscriptions">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Actions Bar -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,16">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Member Subscription Records" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🔄 Refresh" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BtnRefreshSubscriptions_Click"/>
                                <Button Content="+ Assign Membership" Style="{StaticResource PrimaryButtonStyle}" Click="BtnAssignMembership_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Subscriptions DataGrid -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid x:Name="DgMemberships" Style="{StaticResource ModernDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding MembershipId}" Width="60"/>
                                <DataGridTextColumn Header="Member Name" Binding="{Binding MemberName}" Width="180"/>
                                <DataGridTextColumn Header="Plan Name" Binding="{Binding PlanName}" Width="160"/>
                                <DataGridTextColumn Header="Start Date" Binding="{Binding FormattedStartDate}" Width="120"/>
                                <DataGridTextColumn Header="Expiry Date" Binding="{Binding FormattedExpiryDate}" Width="120"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                                <DataGridTemplateColumn Header="Actions" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Renew" Style="{StaticResource ActionGridButtonStyle}" Click="BtnRenew_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock x:Name="TxtSubscriptionCount" Grid.Row="2" Text="Total 0 subscriptions" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="4,8,0,0"/>
                </Grid>
            </TabItem>

            <!-- TAB 2: Membership Plans -->
            <TabItem Header="Plans Catalog">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Actions Bar -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,16">
                        <Grid>
                            <TextBlock Text="Available Gym Membership Plans" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Content="+ Create New Plan" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Click="BtnAddPlan_Click"/>
                        </Grid>
                    </Border>

                    <!-- Plans DataGrid -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid x:Name="DgPlans" Style="{StaticResource ModernDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Plan ID" Binding="{Binding PlanId}" Width="80"/>
                                <DataGridTextColumn Header="Plan Name" Binding="{Binding PlanName}" Width="200"/>
                                <DataGridTextColumn Header="Duration" Binding="{Binding FormattedDuration}" Width="120"/>
                                <DataGridTextColumn Header="Fee" Binding="{Binding FormattedPrice}" Width="120"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                <DataGridTemplateColumn Header="Actions" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Edit" Style="{StaticResource ActionGridButtonStyle}" Click="BtnEditPlan_Click"/>
                                                <Button Content="Delete" Style="{StaticResource DangerButtonStyle}" Click="BtnDeletePlan_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock x:Name="TxtPlanCount" Grid.Row="2" Text="Total 0 plans" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="4,8,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
